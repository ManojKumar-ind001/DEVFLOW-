{
  "name": "devflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=1 build",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm build && pnpm --recursive typecheck",
    "dev:api": "pnpm --filter @devflow/api start",
    "dev:web": "pnpm --filter @devflow/web dev --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
